flowchart TD
    Runner("Runner event loop")
    Status[("status.json<br/>tick at least every 15 s,<br/>pids and start times")]
    Check{"Follower, every 2 s:<br/>runner present,<br/>tick fresh?"}
    Gone(["runner gone<br/>exit 4 at once"])
    Stuck(["runner not responding<br/>120 s warn, 300 s exit 4"])
    StatusCmd["--status<br/>facts and one next: action"]
    Stop["Stop the tracked task,<br/>confirm with --status<br/>that the runner is gone"]
    Reap["--reap: TERM, KILL each<br/>verified group and a live<br/>codex's descendants"]
    Rerun(["Re-run unfinished roles<br/>in a new directory"])

    Runner -->|"writes"| Status
    Status --> Check
    Check -->|"gone, or its pid<br/>is another process"| Gone
    Check -->|"present, no tick<br/>for 120 s"| Stuck
    Gone --> StatusCmd
    Stuck --> StatusCmd
    StatusCmd -->|"not responding"| Stop
    Stop --> StatusCmd
    StatusCmd -->|"gone, task ended,<br/>live codex groups"| Reap
    StatusCmd -->|"gone, no live groups"| Rerun
    Reap --> Rerun

    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef data fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef soft fill:#fef9c3,stroke:#a16207,color:#0f172a
    classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    class Runner ours
    class Status data
    class Check decision
    class Stuck,Stop soft
    class Gone stop
    class StatusCmd,Reap step
    class Rerun ok
