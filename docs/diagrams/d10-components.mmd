flowchart LR
    Claude("Claude Code<br/>orchestrator")
    Host("Host task tracker<br/>attached runs only")
    Runner("Runner CLI<br/>detached by --start")
    Follower("Follower<br/>--follow")
    RunDir[("Run directory<br/>private, one launch,<br/>supervisor lock")]
    State[("Thread state<br/>project, session, role")]
    AppServer[["codex app-server<br/>metadata only"]]
    Workers[["codex exec<br/>one per role"]]
    Workspace[("Workspace")]

    Claude <-->|"inputs in, results out"| RunDir
    Claude -->|"--start, --cancel"| Runner
    Runner <-->|"inputs, outputs, lock"| RunDir
    Runner <-->|"read-only RPCs"| AppServer
    Runner -->|"dispatch"| Workers
    Workers <-->|"work"| Workspace
    Runner <-->|"thread ids"| State
    RunDir -->|"err.log, status.json"| Follower
    Follower -->|"events"| Claude
    Runner -->|"exit, if attached"| Host
    Host -->|"task notification"| Claude

    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef ext fill:#ffedd5,stroke:#c2410c,color:#0f172a
    classDef data fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef person fill:#f3f4f6,stroke:#374151,color:#111827
    class Claude,Runner,Follower ours
    class AppServer,Workers ext
    class RunDir,State,Workspace data
    class Host person
