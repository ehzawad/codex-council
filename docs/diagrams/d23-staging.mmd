flowchart TD
    Mktemp(["mktemp -d<br/>a new private directory"])
    Discover["--discover<br/>writes model-snapshot.json"]
    Write["Claude writes<br/>roles.json and context.md"]
    Preflight{"Preflight, its own<br/>foreground call:<br/>exit 0?"}
    Fix(["exit 2: rewrite the file,<br/>or a new directory"])
    Launch["--start, a separate<br/>foreground call, claims<br/>out.md and err.log"]
    Gate{"Launch gate:<br/>same checks pass?"}
    Restart(["exit 2: start over<br/>in a new directory"])
    Resolve(["Selection resolution,<br/>then fan-out"])

    Mktemp --> Discover
    Discover --> Write
    Write --> Preflight
    Preflight -->|"no"| Fix
    Preflight -->|"yes"| Launch
    Launch --> Gate
    Gate -->|"no"| Restart
    Gate -->|"yes"| Resolve

    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    class Mktemp,Discover,Write,Launch step
    class Preflight,Gate decision
    class Resolve ok
    class Fix,Restart stop
