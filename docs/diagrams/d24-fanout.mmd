flowchart TD
    Panel(["Resolved panel<br/>any number of roles"])
    Queue["One task per role"]
    Permit["Take a permit<br/>max parallel, default 6"]
    Probe{"Role lock free?<br/>nonblocking probe"}
    Wait["Close the lock file,<br/>release the permit,<br/>wait 0.1 s to 2 s"]
    Attempts("Attempt loop<br/>holds lock and permit")
    Callback["As each role settles:<br/>reply file, then K/N line"]
    Gather(["Gathered results<br/>report in input order"])

    Panel --> Queue
    Queue --> Permit
    Permit --> Probe
    Probe -->|"busy"| Wait
    Wait --> Permit
    Probe -->|"acquired"| Attempts
    Attempts --> Callback
    Callback --> Gather

    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef soft fill:#fef9c3,stroke:#a16207,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    class Panel,Queue,Permit,Callback step
    class Probe decision
    class Wait soft
    class Attempts ours
    class Gather ok
