flowchart TD
    User(("User"))
    Claude("Claude Code<br/>with the skill")
    Runner("Council runner")
    Workers[["Codex workers 1..N<br/>codex exec"]]
    Workspace[("Shared workspace")]

    User -->|"objective"| Claude
    Claude -->|"reconciled result"| User
    Claude -->|"roles, shared context"| Runner
    Runner -->|"replies, report"| Claude
    Runner -->|"dispatch"| Workers
    Workers -->|"evidence"| Runner
    Claude <-->|"investigate, check"| Workspace
    Workers <-->|"authorized work"| Workspace

    classDef person fill:#f3f4f6,stroke:#374151,color:#111827
    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef ext fill:#ffedd5,stroke:#c2410c,color:#0f172a
    classDef data fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    class User person
    class Claude,Runner ours
    class Workers ext
    class Workspace data
