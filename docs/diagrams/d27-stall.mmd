flowchart TD
    Stalled(["Stalled attempt"])
    Completed{"Turn completed, and a<br/>final message buffered?"}
    Warn(["ok, with a warning<br/>state saved best-effort"])
    Unsafe{"Any item besides<br/>message, reasoning,<br/>or error notice, or a line<br/>that is not a JSON object?"}
    Terminal(["[stall]<br/>terminal, no replay"])
    Retriable(["[retriable:stall]<br/>replay is safe"])
    Budget(["Shared retry budget<br/>see d28"])

    Stalled --> Completed
    Completed -->|"yes"| Warn
    Completed -->|"no"| Unsafe
    Unsafe -->|"yes"| Terminal
    Unsafe -->|"no"| Retriable
    Retriable --> Budget

    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    classDef soft fill:#fef9c3,stroke:#a16207,color:#0f172a
    classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    class Stalled step
    class Completed,Unsafe decision
    class Warn ok
    class Retriable,Budget soft
    class Terminal stop
