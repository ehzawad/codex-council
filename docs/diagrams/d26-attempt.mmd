flowchart TD
    Cmd(["Prompt on stdin,<br/>argv with sent values"])
    Group[["codex exec<br/>in its own process group"]]
    Pumps["stdout and stderr pumps<br/>every byte resets this<br/>attempt's activity clock"]
    Watchdog{"Silent past the<br/>watchdog threshold?"}
    Tree["Live tree: one ps snapshot<br/>finds the groups and pids<br/>of the live codex's descendants"]
    Owner["Termination owner<br/>TERM, then KILL the group<br/>and those descendants"]
    Drain["Post-exit drain<br/>up to 10 s for EOF;<br/>still open: warn"]
    Sweep["Sweep the group only<br/>codex has exited, so its<br/>tree can no longer be traced"]
    Result(["CodexRun<br/>exit, output, flags"])

    Cmd --> Group
    Group --> Pumps
    Pumps --> Watchdog
    Watchdog -->|"yes: stalled<br/>(or a cancellation)"| Tree
    Tree --> Owner
    Group -->|"codex exits<br/>on its own"| Drain
    Drain --> Sweep
    Owner --> Sweep
    Sweep --> Result

    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef ext fill:#ffedd5,stroke:#c2410c,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef soft fill:#fef9c3,stroke:#a16207,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    class Cmd,Pumps,Drain,Sweep step
    class Group ext
    class Watchdog decision
    class Tree,Owner soft
    class Result ok
