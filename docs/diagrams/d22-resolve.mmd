flowchart TD
    Inputs[("roles.json and the<br/>planning snapshot")]
    Automatic{"An automatic choice,<br/>with routing on?"}
    Supported{"Does the snapshot<br/>support it?"}
    Repair(["Preflight: exit 2,<br/>rewrite roles.json here"])
    Refuse(["Launch: exit 2, start<br/>over in a new directory"])
    Launch{"At launch?"}
    Fresh[["One fresh discovery,<br/>frozen for the council"]]
    Resolver("Pure resolver<br/>one decision per role")
    Consumers(["Preflight plan, or<br/>launch argv and report"])

    Inputs --> Automatic
    Automatic -->|"yes"| Supported
    Automatic -->|"no: a user pin,<br/>inheritance, or<br/>routing off"| Resolver
    Supported -->|"no, at preflight"| Repair
    Supported -->|"no, at launch"| Refuse
    Supported -->|"yes"| Launch
    Launch -->|"yes"| Fresh
    Launch -->|"no"| Resolver
    Fresh --> Resolver
    Resolver --> Consumers

    classDef data fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    classDef ext fill:#ffedd5,stroke:#c2410c,color:#0f172a
    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef soft fill:#fef9c3,stroke:#a16207,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    class Inputs data
    class Automatic,Supported,Launch decision
    class Repair soft
    class Refuse stop
    class Fresh ext
    class Resolver ours
    class Consumers ok
