flowchart TD
    Roles[("roles.json")]
    Snapshot[("Planning snapshot")]
    Gate{"Authoring gate:<br/>snapshot supports<br/>every choice?"}
    Exit2(["exit 2<br/>rewrite roles.json"])
    Refresh{"Launch, routing on,<br/>an automatic role?"}
    Fresh[["Fresh launch<br/>discovery"]]
    Resolver("Pure resolver<br/>one decision per role")
    Decisions["Frozen decisions<br/>attached to each role"]
    Consumers(["Preflight plan, or<br/>launch argv and report"])

    Roles --> Gate
    Snapshot --> Gate
    Gate -->|"no"| Exit2
    Gate -->|"yes"| Refresh
    Refresh -->|"yes"| Fresh
    Fresh -->|"launch evidence"| Resolver
    Refresh -->|"no: planning evidence"| Resolver
    Resolver --> Decisions
    Decisions --> Consumers

    classDef data fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef stop fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    classDef ext fill:#ffedd5,stroke:#c2410c,color:#0f172a
    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    class Roles,Snapshot data
    class Decisions step
    class Gate,Refresh decision
    class Exit2 stop
    class Fresh ext
    class Resolver ours
    class Consumers ok
