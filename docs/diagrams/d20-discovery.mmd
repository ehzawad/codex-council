flowchart TD
    Caller(["--discover RUNDIR,<br/>or a launch"])
    Context["Execution context<br/>PATH codex, cwd, env,<br/>project root"]
    Version[["codex --version"]]
    AppServer[["codex app-server<br/>read-only RPCs"]]
    Normalize("Normalize, then<br/>judge eligibility")
    Snapshot[("model-snapshot.json<br/>0600, this run only")]
    Summary(["Summary with<br/>snapshot_id, exit 0"])

    Caller --> Context
    Context --> Version
    Context --> AppServer
    Version --> Normalize
    AppServer --> Normalize
    Normalize -->|"--discover"| Snapshot
    Snapshot --> Summary
    Normalize -.->|"launch: in memory"| Caller

    classDef step fill:#ffffff,stroke:#475569,color:#0f172a
    classDef ours fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef ext fill:#ffedd5,stroke:#c2410c,color:#0f172a
    classDef data fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef ok fill:#dcfce7,stroke:#15803d,color:#0f172a
    class Caller,Context step
    class Normalize ours
    class Version,AppServer ext
    class Snapshot data
    class Summary ok
